# =============================================================================
#  Advisor Copilot — environment
# =============================================================================
# Copy to `.env.local` for development. The app runs fully WITHOUT any of these
# (offline deterministic router + in-memory data). Set them to enable the real
# integrations.

# ---- Session signing -------------------------------------------------------
# HMAC secret for the signed session cookie. REQUIRED in production.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# ---- LLM (optional) --------------------------------------------------------
# When set, tool SELECTION is delegated to Claude (tool-calling). The model
# never sees raw data, never writes SQL, and its choice is still authorized
# server-side + at the data layer. Without a key, the offline router is used.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- PostgreSQL (production data mart) -------------------------------------
# The reference app uses an in-memory store. In production, point the data
# layer at PostgreSQL and load db/schema.sql + db/policies.sql. Identity is set
# per-request via `SET LOCAL app.current_advisor_id` + `SET LOCAL role`.
# DATABASE_URL=postgres://user:pass@host:5432/advisory
